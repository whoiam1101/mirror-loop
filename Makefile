.PHONY: install hooks hooks-validate hooks-status hooks-run hooks-run-push hooks-check hooks-update deps-update update hooks-uninstall secrets format fix lint typecheck test bench bench-compare check

HOOKS_DIR := $(shell git rev-parse --git-path hooks)
RUN ?= uv run

install:
	uv sync --all-groups
	$(MAKE) hooks

hooks:
	$(RUN) pre-commit install --install-hooks --hook-type pre-commit --hook-type pre-push

hooks-validate:
	$(RUN) pre-commit validate-config .pre-commit-config.yaml

hooks-status:
	for hook in pre-commit pre-push; do \
	grep -qs "File generated by pre-commit" "$(HOOKS_DIR)/$$hook" \
	&& echo "$$hook: installed" \
	|| { echo "$$hook: NOT installed (run: make hooks)"; exit 1; }; \
	done

hooks-run:
	$(RUN) pre-commit run --all-files

hooks-run-push:
	$(RUN) pre-commit run --all-files --hook-stage pre-push

hooks-check: hooks-validate hooks-status hooks-run hooks-run-push

hooks-update:
	$(RUN) pre-commit autoupdate
	$(MAKE) hooks-validate
	$(MAKE) hooks
	$(RUN) pre-commit gc
	$(MAKE) hooks-run
	git --no-pager diff -- .pre-commit-config.yaml

deps-update:
	uv lock --upgrade
	uv sync --all-groups

update: deps-update hooks-update

hooks-uninstall:
	$(RUN) pre-commit uninstall --hook-type pre-commit --hook-type pre-push

secrets:
	$(RUN) pre-commit run gitleaks-history --hook-stage pre-push --all-files

format:
	$(RUN) ruff format .

fix:
	$(RUN) ruff check --fix .
	$(RUN) ruff format .

lint:
	$(RUN) ruff format --check .
	$(RUN) ruff check .

typecheck:
	$(RUN) ty check --error-on-warning

test:
	$(RUN) pytest

bench:
	$(RUN) pytest benchmarks --benchmark-only --benchmark-autosave

bench-compare:
	$(RUN) pytest benchmarks --benchmark-only --benchmark-compare --benchmark-compare-fail=mean:10%

check: lint typecheck test
